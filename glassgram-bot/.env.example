# Telegram
BOT_TOKEN=123456:ABC...
# Telegram ids that may use /grant, /revoke and /payments (comma separated)
ADMIN_IDS=7262597406

# Platega (personal account > settings)
PLATEGA_MERCHANT_ID=00000000-0000-0000-0000-000000000000
PLATEGA_SECRET=your-api-key
PLATEGA_BASE_URL=https://app.platega.io
# Amounts offered in the bot, RUB (comma separated); the user may also type their own
DONATE_AMOUNTS=100,300,500,1000
DONATE_MIN=50
DONATE_MAX=100000

# Public HTTPS address of this server: Platega posts payment statuses to
# <PUBLIC_URL>/platega/callback (set that URL in the Platega account as the callback URL)
PUBLIC_URL=https://bot.example.com
# Where the callback server listens (put it behind nginx/Caddy with a valid certificate)
WEB_HOST=127.0.0.1
WEB_PORT=8080

# GitHub: a fine-grained token with "Contents: Read and write" on shashachkaaa/Glassgram only
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=shashachkaaa/Glassgram
GITHUB_BRANCH=master
BADGES_PATH=glassgram-api/badges.json
BADGE_ID=supporter

DB_PATH=glassgram_bot.sqlite3
